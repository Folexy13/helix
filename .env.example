# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key

# Amazon Bedrock Configuration
BEDROCK_ENDPOINT_URL=https://bedrock-runtime.us-east-1.amazonaws.com

# Nova Model IDs
NOVA_LITE_MODEL_ID=amazon.nova-lite-v2:0
NOVA_SONIC_MODEL_ID=amazon.nova-sonic-v2:0
NOVA_EMBEDDINGS_MODEL_ID=amazon.nova-embed-multimodal-v1:0

# GitHub Configuration (for Pillar 2 & 3)
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_OWNER=your_github_username
GITHUB_REPO=your_repository_name

# GitHub OAuth Configuration (for user repository connection)
# Create an OAuth App at: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# Application URL (for OAuth callbacks)
APP_URL=http://localhost:8000

# Voice Configuration
VOICE_SAMPLE_RATE=16000
VOICE_CHANNELS=1

# Session Configuration
SESSION_TIMEOUT_MINUTES=30
MAX_CONVERSATION_HISTORY=100

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Development
DEBUG=false

# Redis Configuration
# Local development: Use local Redis (started via docker-compose)
# REDIS_URL=redis://localhost:6379/0

# Production: Use your cloud Redis instance (AWS ElastiCache, Redis Cloud, etc.)
# REDIS_URL=redis://:your_password@your-redis-host.com:6379/0
# REDIS_PASSWORD=your_redis_password
# REDIS_SSL=true

# Note: If REDIS_URL is not set, the application will use in-memory storage
# which is fine for development but NOT recommended for production
